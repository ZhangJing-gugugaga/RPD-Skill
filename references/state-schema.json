{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RPD Project State File Frontmatter",
  "description": "Schema for .project-state.md YAML frontmatter",
  "type": "object",
  "required": ["name", "created", "last-synced", "status", "entry-type"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "State file schema version, used for migration"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Project name (kebab-case, Chinese, or mixed)"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "last-synced": {
      "type": "string",
      "format": "date-time",
      "description": "Last sync timestamp in ISO 8601 format"
    },
    "last-modified-by": {
      "type": "string",
      "description": "Agent identifier who last modified this file"
    },
    "status": {
      "type": "string",
      "enum": ["planning", "in-development", "paused", "completed"],
      "description": "Current project status"
    },
    "entry-type": {
      "type": "string",
      "enum": ["new-idea", "half-finished", "continued"],
      "description": "How the project was initialized"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing revision number for conflict detection"
    },
    "branch-affinity": {
      "type": "string",
      "description": "Git branch this state file is bound to; state-guard.py hard-blocks writes from other branches (cross-branch overwrite protection)"
    },
    "last-commit-sha": {
      "type": "string",
      "description": "Git HEAD sha at last sync; used to detect code drift vs state"
    }
  },
  "additionalProperties": false
}
